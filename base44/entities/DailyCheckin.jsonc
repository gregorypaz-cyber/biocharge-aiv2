{
  "name": "DailyCheckin",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of the check-in (YYYY-MM-DD, local timezone)"
    },
    "rest_day": {
      "type": "boolean",
      "default": false,
      "description": "True if this is a rest/recovery day with no training"
    },
    "biocharge_morning": {
      "type": "number",
      "description": "BioCharge morning score (0-100)"
    },
    "biocharge_pre_workout": {
      "type": "number",
      "description": "BioCharge pre-workout score (0-100)"
    },
    "biocharge_post_workout": {
      "type": "number",
      "description": "BioCharge post-workout score (0-100)"
    },
    "sleep_score": {
      "type": "number",
      "description": "Sleep score from Zepp (0-100). Calibration reference only - never enters recovery decision logic."
    },
    "fatigue": {
      "type": "number",
      "description": "Fatigue level (0-100)"
    },
    "deep_sleep_pct": {
      "type": "number",
      "description": "Deep sleep percentage (0-100)"
    },
    "rem_sleep_pct": {
      "type": "number",
      "description": "REM sleep percentage (0-100) from Zepp"
    },
    "sleep_awakenings": {
      "type": "number",
      "description": "Number of times woken during the night (from Zepp). Higher = more fragmented sleep."
    },
    "awake_minutes": {
      "type": "number",
      "description": "Minutes spent awake while in bed (Zepp > Sono > Acordado; Fitbit > minutesAwake). Raw portable signal. Leave BLANK when not measured - never 0 as a placeholder. Enables sleep efficiency = asleep / (asleep + awake)."
    },
    "sleep_regularity_pct": {
      "type": "number",
      "description": "Sleep regularity percentage 0-100 (from Zepp SRI). Feeds calculateSleepScore with weight 0.25. WARNING: Zepp reports 0 when it could not compute the index (e.g. nights the watch was not worn). 0 means MISSING, not zero regularity - always leave BLANK in that case, or the sleep score is penalised by a phantom value."
    },
    "sleep_start_time": {
      "type": "string",
      "description": "Bedtime / sleep onset as HH:MM (from Zepp). Context only \u2014 not used in the sleep score."
    },
    "dinner_time": {
      "type": "string",
      "description": "Dinner time as HH:MM. Context only \u2014 used to compute dinner-to-bed interval for later correlation analysis."
    },
    "sleep_heart_rate": {
      "type": "number",
      "description": "Average heart rate during sleep in bpm (from Zepp). Rising trend can signal stress/overload."
    },
    "rpe": {
      "type": "number",
      "description": "Rate of Perceived Exertion (1-10)"
    },
    "mood": {
      "type": "number",
      "description": "Mood (1-5)"
    },
    "stress": {
      "type": "number",
      "description": "Stress level (1-5)"
    },
    "energy": {
      "type": "number",
      "description": "Energy level (1-5)"
    },
    "hydration": {
      "type": "number",
      "description": "Hydration level (1-5)"
    },
    "muscle_soreness": {
      "type": "number",
      "description": "Muscle soreness (1-5)"
    },
    "sleep_hours": {
      "type": "number",
      "description": "Hours of sleep"
    },
    "resting_hr": {
      "type": "number",
      "description": "Resting heart rate"
    },
    "hrv": {
      "type": "number",
      "description": "Legacy HRV field kept for compatibility. Prefer hrv_manual / RMSSD when available."
    },
    "body_weight": {
      "type": "number",
      "description": "Body weight in kg"
    },
    "notes": {
      "type": "string",
      "description": "Daily observations"
    },
    "recovery_score": {
      "type": "number",
      "description": "Calculated recovery score"
    },
    "morning_recovery_score": {
      "type": "number",
      "description": "Frozen morning recovery anchor saved at check-in time and preserved during the day"
    },
    "zone": {
      "type": "string",
      "enum": [
        "green",
        "yellow",
        "red"
      ],
      "description": "Recovery zone"
    },
    "recommendation": {
      "type": "string",
      "description": "Training recommendation"
    },
    "alert": {
      "type": "string",
      "description": "Alert status"
    },
    "training_load": {
      "type": "string",
      "description": "Training load assessment"
    },
    "delta_pre": {
      "type": "number",
      "description": "Delta BioCharge pre-workout"
    },
    "delta_post": {
      "type": "number",
      "description": "Delta BioCharge post-workout"
    },
    "daily_strain_accumulated": {
      "type": "number",
      "description": "Total strain accumulated from all training sessions today (0-100)"
    },
    "current_body_state": {
      "type": "string",
      "enum": [
        "Recovered",
        "Activated",
        "Balanced",
        "Loaded",
        "Sympathetic_Load",
        "Fatigued",
        "Overreached"
      ],
      "description": "Current physiological body state \u2014 updated after each training session"
    },
    "remaining_capacity": {
      "type": "string",
      "enum": [
        "High",
        "Moderate",
        "Low",
        "Minimal"
      ],
      "description": "Remaining training capacity for the day"
    },
    "recovery_demand": {
      "type": "number",
      "description": "How much recovery the day demands (0-100)"
    },
    "sleep_need_tonight": {
      "type": "number",
      "description": "Recommended hours of sleep tonight"
    },
    "next_day_forecast": {
      "type": "string",
      "description": "AI-generated forecast for the next day"
    },
    "headline_today": {
      "type": "string",
      "description": "AI-generated headline summarizing the day's physiological status (max ~12 words)"
    },
    "delayed_fatigue_alert": {
      "type": "string",
      "description": "Alert about delayed fatigue patterns detected from history"
    },
    "hrv_manual": {
      "type": "number",
      "description": "RMSSD in ms entered manually by the user"
    },
    "resting_heart_rate": {
      "type": "number",
      "description": "Resting heart rate (alias for resting_hr)"
    },
    "sleep_quality": {
      "type": "number",
      "description": "Calculated sleep quality score (0-100). This is the app's own calculateSleepScore v2 output persisted - NOT the Zepp sleep score (that one is sleep_score)."
    },
    "energy_level": {
      "type": "number",
      "description": "Energy level (1-5)"
    },
    "stress_level": {
      "type": "number",
      "description": "Stress level (1-5)"
    },
    "muscle_soreness_level": {
      "type": "number",
      "description": "Muscle soreness level (1-5)"
    },
    "mood_level": {
      "type": "number",
      "description": "Mood level (1-5)"
    },
    "hydration_liters": {
      "type": "number",
      "description": "Water intake in liters"
    },
    "deep_analysis_text": {
      "type": "string",
      "description": "AI-generated deep analysis text, auto-generated on morning check-in save"
    },
    "contextual_bullets": {
      "type": "string",
      "description": "JSON array of max 2 contextual training bullets generated on check-in save"
    }
  },
  "required": [
    "date",
    "biocharge_morning"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}