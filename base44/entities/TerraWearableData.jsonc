{
  "name": "TerraWearableData",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "description": "Type of data from Terra (e.g. sleep, activity, daily)"
    },
    "provider": {
      "type": "string",
      "description": "Wearable provider (e.g. ZEPP)"
    },
    "raw_payload": {
      "type": "string",
      "description": "Full JSON payload received from the Terra webhook"
    }
  },
  "required": [
    "type",
    "provider",
    "raw_payload"
  ]
}